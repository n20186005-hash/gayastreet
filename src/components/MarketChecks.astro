---
import { checks } from '../i18n/checks';
import { place } from '../lib/place';
interface Props {lang:string;}
const {lang}=Astro.props;const c=checks[lang];
---
<section id="market-times" class="market-checks wrap"><p class="eyebrow">{c.checked}</p><h2>{c.heading}</h2><div class="checks-grid"><article><h3>{c.sunday}</h3><p>{c.sundayHours}</p><a class="text-link" href={'/'+lang+'/sunday-market/'}>{c.more} →</a></article><article><h3>{c.night}</h3><p>{c.nightHours}</p><a class="text-link" href={'/'+lang+'/night-market/'}>{c.more} →</a></article></div><p>{c.notice}</p><p>{c.rating}</p><div class="checks-links"><a href={place.hasMap} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href="https://sabahtourism.com/article/gaya-street-the-sensational-weekend-street/" target="_blank" rel="noopener noreferrer">Sabah Tourism Board ↗</a></div></section>
