---
import '../../styles/global.css';
import SeoHead from '../../components/SeoHead.astro';
import PageBody from '../../components/PageBody.astro';
import { translations } from '../../i18n/translations';
import { languages } from '../../i18n/ui';
import { postalAddress as address, geo, place } from '../../lib/place';
import { webp } from '../../lib/images';

export function getStaticPaths() {
  return Object.keys(translations).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const t = translations[lang];
const locales = Object.keys(translations);
const currentPath = Astro.url.pathname;
const canonical = Astro.site ? new URL(currentPath, Astro.site).toString() : undefined;
const siteUrl = Astro.site ? Astro.site.toString() : undefined;

const OG_IMAGE = '/og-cover.jpg';
const ogImage = Astro.site ? new URL(OG_IMAGE, Astro.site).toString() : OG_IMAGE;
const heroImage = webp('/gallery/gaya-street-market-3.jpg', 1400);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Gaya Street Field Notes',
      inLanguage: locales.map((l) => languages[l].htmlLang),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: t.meta.title,
      description: t.meta.description,
      inLanguage: t.htmlLang,
      isPartOf: { '@id': `${siteUrl}#website` },
      primaryImageOfPage: ogImage,
    },
    {
      '@type': 'TouristAttraction',
      '@id': `${canonical}#attraction`,
      name: 'Gaya Street Market',
      alternateName: ['Pasar Minggu Gaya Street', 'Gaya Street Sunday Market', 'Jalan Gaya'],
      description: t.meta.description,
      url: canonical,
      image: ogImage,
      address,
      geo,
      hasMap: place.hasMap,
      isAccessibleForFree: true,
      publicAccess: true,
      touristType: t.jsonLd.touristType,
      sameAs: [place.hasMap],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: t.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <SeoHead
      lang={lang}
      title={t.meta.title}
      description={t.meta.description}
      path={currentPath}
      jsonLd={jsonLd}
      heroImage={heroImage}
    />
  </head>
  <body>
    <PageBody t={t} lang={lang} />
  </body>
</html>
