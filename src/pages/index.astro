    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="照片大图">
      <button class="lightbox-close" type="button" aria-label="关闭">&times;</button>
      <button class="lightbox-prev" type="button" aria-label="上一张">← 上一张</button>
      <img src="" alt="" />
      <figcaption></figcaption>
      <span class="lightbox-counter"></span>
      <button class="lightbox-next" type="button" aria-label="下一张">下一张 →</button>
    </div>
    <script is:inline>
      // @ts-nocheck
      (function () {
        var items = Array.prototype.slice.call(document.querySelectorAll('.gallery-grid button'));
        var lb = document.getElementById('lightbox');
        if (!lb || !items.length) return;
        var img = lb.querySelector('img');
        var cap = lb.querySelector('figcaption');
        var counter = lb.querySelector('.lightbox-counter');
        var idx = 0;
        function show(i) {
          idx = (i + items.length) % items.length;
          var el = items[idx];
          img.src = el.getAttribute('data-src');
          img.alt = el.getAttribute('data-cap');
          cap.textContent = el.getAttribute('data-cap');
          counter.textContent = (idx + 1) + ' / ' + items.length;
        }
        items.forEach(function (el, i) {
          el.addEventListener('click', function () { show(i); lb.classList.add('open'); document.body.style.overflow = 'hidden'; });
        });
        lb.querySelector('.lightbox-close').addEventListener('click', close);
        lb.querySelector('.lightbox-prev').addEventListener('click', function () { show(idx - 1); });
        lb.querySelector('.lightbox-next').addEventListener('click', function () { show(idx + 1); });
        lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
        document.addEventListener('keydown', function (e) {
          if (!lb.classList.contains('open')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowLeft') show(idx - 1);
          if (e.key === 'ArrowRight') show(idx + 1);
        });
        function close() { lb.classList.remove('open'); document.body.style.overflow = ''; }
      })();
    </script>
  </body>
