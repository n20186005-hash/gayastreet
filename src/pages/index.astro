---
import '../styles/global.css';

const title = 'Gaya Street Kota Kinabalu — 走进亚庇最有生活感的一条街';
const description = '一份以当地节奏为线索的加雅街旅行田野笔记：周日市集、老店屋、早餐、交通和附近散步路线。';
const mapUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3968.09116592099!2d116.07368461214215!3d5.982184143977763!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x323b698f870637b5%3A0xfbb01a6fe8fa566d!2z5Yqg6ZuF6KGX56S85ouc5aSp5biC5Zy6!5e0!3m2!1sms!2sus!4v1786583517386!5m2!1sms!2sus';
const mapsUrl = 'https://maps.app.goo.gl/i1PGV12Mrwiad9M28';
const image = {
  hero: '/gallery/gaya-street-market-3.jpg',
  market: '/gallery/gaya-street-market-2.jpg',
  heritage: '/gallery/gaya-street-market-1.jpg',
  food: '/gallery/gaya-street-market-4.jpg',
  mark: '/gaya-mark.svg',
};
const gallery = [
  { src: '/gallery/gaya-street-market-1.jpg', cap: '加雅街老店屋的五脚基骑楼立面' },
  { src: '/gallery/gaya-street-market-2.jpg', cap: '周日市集的水果与手作摊位' },
  { src: '/gallery/gaya-street-market-3.jpg', cap: '清晨从街口开始苏醒的加雅街' },
  { src: '/gallery/gaya-street-market-4.jpg', cap: 'kopi、早餐与街边的慢时光' },
  { src: '/gallery/gaya-street-market-5.jpg', cap: '市集里的色彩与本地手作' },
  { src: '/gallery/gaya-street-market-6.jpg', cap: '摊位之间，是亚庇的日常' },
  { src: '/gallery/gaya-street-market-7.jpg', cap: '午后阴影下的老店屋立面' },
  { src: '/gallery/gaya-street-market-8.jpg', cap: '沿街招牌与五脚基的安静风景' },
];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL(image.hero, Astro.site).toString() : image.hero;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TouristAttraction',
      name: 'Gaya Street Market',
      alternateName: 'Pasar Minggu Gaya Street',
      description,
      url: canonical,
      image: ogImage,
      address: { '@type': 'PostalAddress', streetAddress: 'Jalan Gaya', addressLocality: 'Kota Kinabalu', postalCode: '88000', addressRegion: 'Sabah', addressCountry: 'MY' },
      geo: { '@type': 'GeoCoordinates', latitude: 5.9821841, longitude: 116.0736846 },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Sunday',
        opens: '07:00',
        closes: '12:00',
      },
      touristType: '本地市民与旅行者，适合步行与摄影',
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.4', reviewCount: '8967' },
      sameAs: [
        'https://www.sabahtourism.com/',
        'https://en.wikipedia.org/wiki/Kota_Kinabalu',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: '加雅街周日市集什么时候最值得逛？', acceptedAnswer: { '@type': 'Answer', text: '建议周日早上七点至十点抵达，气温较舒服，摊位和早餐选择也最完整。' } },
        { '@type': 'Question', name: '周日市集几点收摊？', acceptedAnswer: { '@type': 'Answer', text: '市集通常在中午十二点左右结束，摊主从十一点半开始陆续收摊，想逛得完整建议早点到。' } },
        { '@type': 'Question', name: '周日车辆能进入加雅街吗？', acceptedAnswer: { '@type': 'Answer', text: '周日市集期间 Jalan Gaya 会封路给行人，车辆需绕行，建议把车停在外围公共停车场或商场停车场。' } },
        { '@type': 'Question', name: '从亚庇机场怎么去加雅街？', acceptedAnswer: { '@type': 'Answer', text: '机场到市中心约八公里，可选择出租车、网约车或机场巴士，再步行进入 Jalan Gaya。' } },
        { '@type': 'Question', name: '市集收现金还是电子支付？', acceptedAnswer: { '@type': 'Answer', text: '摊位以现金为主，建议准备小额马币（RM）；部分店家支持扫码支付，可在消费前询问。' } },
        { '@type': 'Question', name: '需要门票吗？', acceptedAnswer: { '@type': 'Answer', text: '街道与周日市集通常不设门票，个别摊位消费和附近景点费用另计。' } },
      ],
    },
  ],
};
const faq = [
  { q: '加雅街周日市集什么时候最值得逛？', a: '建议周日早上七点至十点抵达，气温较舒服，摊位和早餐选择也最完整。' },
  { q: '周日市集几点收摊？', a: '市集通常在中午十二点左右结束，摊主从十一点半开始陆续收摊，想逛得完整建议早点到。' },
  { q: '周日车辆能进入加雅街吗？', a: '周日市集期间 Jalan Gaya 会封路给行人，车辆需绕行，建议把车停在外围公共停车场或商场停车场。' },
  { q: '从亚庇机场怎么去加雅街？', a: '机场到市中心约八公里，可选择出租车、网约车或机场巴士，再步行进入 Jalan Gaya。' },
  { q: '市集收现金还是电子支付？', a: '摊位以现金为主，建议准备小额马币（RM）；部分店家支持扫码支付，可在消费前询问。' },
  { q: '需要门票吗？', a: '街道与周日市集通常不设门票，个别摊位消费和附近景点费用另计。' },
];
const timeline = [
  { year: '名字的由来 · 据传', title: '“加雅”一名的两种说法', text: '一说来自街南的加雅湾与加雅岛（Pulau Gaya）；另一流传说法与英属北婆罗洲时期的殖民官员有关，中文旧记常写作“加雅”。两种说法并存，史实尚待考证。' },
  { year: '1905', title: '艾京生钟楼落成', text: '为纪念英属北婆罗洲首任总督 Francis George Atkinson 而建，矗立在信号山（Signal Hill）上，是亚庇在战火中幸存的战前建筑之一——逛加雅街时抬头就能看见。' },
  { year: '1931', title: 'Jesselton 之名', text: '英属北婆罗洲特许公司副董事长 Charles Jessel 的名字，被赋予这座新兴港口城市。加雅街所在的杰塞尔顿老城，从此开始生长。' },
  { year: '1943–1945', title: '战火中的城市', text: '二战期间杰塞尔顿城区遭盟军轰炸，几乎夷为平地，大量战前建筑被毁。' },
  { year: '1950 年代', title: '战后重建与五脚基', text: '城市重建，加雅街两侧的老店屋多为这一时期产物：五脚基（five-foot way）骑楼是殖民时代规划留下的建筑语言，把店铺、行人和亚庇的天气连在一起。' },
  { year: '1968', title: '更名哥打京那巴鲁', text: '杰塞尔顿更名 Kota Kinabalu，中文习惯称“亚庇”，加雅街继续作为老城的生活主轴。' },
  { year: '1970s–80s', title: '周日市集成型', text: 'Pasar Minggu 从沿街摊贩逐渐演变为每周日封路的大型露天市场，成为亚庇延续至今的星期天仪式。' },
];
const stories = [
  { no: 'I', tag: '名字传说 · 据传', title: '“Gaya”从何而来？', text: '最常见的说法是得名于加雅湾与加雅岛；另有资料认为与殖民时期官员有关。由于缺乏确凿档案，两条线索被并存讲述——这也是本地人聊天时常有的开场白。', note: '史实存疑，两说并存。' },
  { no: 'II', tag: '街口牌楼', title: '牌楼下的“国泰民安”', text: '加雅街两端立有中式牌楼，额题寄托着对街区平安兴旺的祝愿。它们既是老华人社区的入口意象，也成了市集照片里最常见的取景框。', note: '拍照的人，总爱站在牌楼下。' },
  { no: 'III', tag: '店屋口述', title: '五脚基下的三代人', text: '1950 年代重建的店屋，许多仍是家族经营：楼下开店、楼上住家。老店主们说，五脚基是店的一部分，也是街的一部分——泡茶、下棋、等客来。', note: '口述整理，仅供参考。' },
];
const walk = [
  { step: '01', title: '从牌楼起步', note: '找到街口的牌楼，加雅街就从这里开始。平日是车流与老店，周日是市集的第一排摊位。' },
  { step: '02', title: '市集段 · 07:00–12:00', note: '先找蒸汽与香气：水果、藤编、手作、本地小吃。不必赶路，把“买什么”的决定交给眼睛。' },
  { step: '03', title: '抬头看老店屋', note: '沿街的五脚基骑楼、褪色招牌与旧式百叶窗，是加雅街最安静的风景。' },
  { step: '04', title: '向信号山方向', note: '往南望见艾京生钟楼，它是加雅街望向过去的一扇窗，山脚下可以继续老城散步。' },
  { step: '05', title: '夜市收尾', note: '傍晚回到 Jalan Gaya 一带，Api-Api 夜市的烟火气，给这条街的白天画上句号。' },
];
const sources = [
  { label: 'Sabah Tourism · 沙巴旅游局', href: 'https://www.sabahtourism.com/', tag: '官方' },
  { label: 'Wikipedia · Kota Kinabalu 词条', href: 'https://en.wikipedia.org/wiki/Kota_Kinabalu', tag: '百科' },
  { label: '现场走访与摊贩口述（非营利整理）', href: mapsUrl, tag: '田野笔记' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YJTNXGWZNY"></script>
    <script is:inline>
      // @ts-nocheck
      window['dataLayer'] = window['dataLayer'] || [];
      window['gtag'] = window['gtag'] || function(){ window['dataLayer'].push(arguments); };
      window['gtag']('js', new Date()); window['gtag']('config', 'G-YJTNXGWZNY');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Gaya Street Field Notes home"><img src={image.mark} alt="加雅街印章标志" width="42" height="42" /><span>GAYA STREET<br /><em>FIELD NOTES</em></span></a>
      <nav aria-label="主要导航"><a href="#story">街区气质</a><a href="#history">历史</a><a href="#market">市集</a><a href="#walk">路线</a><a class="nav-marker" href="#map">→ 地图</a></nav>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero-image" src={image.hero} alt="清晨的加雅街周日市集：沿街摊位与渐渐聚拢的人群" />
        <div class="hero-shade"></div>
        <div class="hero-copy"><p class="eyebrow light">05°58′N / 116°04′E · SABAH, MALAYSIA</p><h1>走进<br /><i>加雅街</i></h1><p class="hero-lede">在亚庇，星期天从一杯 kopi 和一条慢慢变热的街开始。</p><a class="button button-yellow" href="#story">开始步行 <span>↓</span></a></div>
        <div class="hero-note"><span>FIELD NOTE 01</span><strong>Jalan Gaya</strong><small>一条从早餐开始的城市散步</small></div>
      </section>

      <section class="intro wrap" id="story"><div class="section-kicker"><span>01</span><span>THE STREET</span></div><div class="intro-copy"><p class="eyebrow">不是景点清单，是一段街道的脉搏。</p><h2>旧店屋下，<br /><i>周日有自己的速度。</i></h2><p>加雅街是亚庇老城区里最适合用脚认识的地方。工作日，它是咖啡店、老招牌和午后阴影；周日，整条 Jalan Gaya 让给市集，人们带着水果、手作、早餐和一点不赶时间的心情走来。</p><a class="text-link" href="#history">先听它的故事 →</a></div><div class="intro-aside"><div class="stamp">KK<br /><b>88000</b></div><p>这份笔记写给第一次来，也写给每次经过都会多停十分钟的人。</p></div></section>

      <section class="glance-band wrap"><div class="section-kicker"><span>02</span><span>AT A GLANCE</span></div><div class="glance-grid"><div class="glance-item"><span>地址</span><strong>Jalan Gaya, 88000</strong><small>亚庇老城区 · Sabah, Malaysia</small></div><div class="glance-item glance-focus"><span>周日市集</span><strong>周日 07:00–12:00</strong><small>封路变成步行市集</small></div><div class="glance-item"><span>门票</span><strong>免费</strong><small>摊位消费另计</small></div><div class="glance-item"><span>最佳时段</span><strong>清晨</strong><small>凉爽、摊位最完整</small></div><div class="glance-item"><span>停留时长</span><strong>2–3 h</strong><small>加老城散步可排半天</small></div><div class="glance-item"><span>评分</span><strong>4.4 / 8,967</strong><small>综合访客评价</small></div></div></section>

      <section class="history-section wrap" id="history"><div class="section-kicker"><span>03</span><span>STREET HISTORY</span></div><div class="history-grid"><div class="history-intro"><p class="eyebrow">一段街道，七次转身。</p><h2>从钟楼到市集，<br /><i>这条街一直在改名字。</i></h2><p>加雅街的年纪比亚庇这个名字更老。它在轰炸后重建，在更名里长大，最后把星期天留给了市集。顺着时间往下走，就是这座城市的近代史。</p></div><div class="timeline">{timeline.map((t) => (<div class="timeline-item"><span class="timeline-year">{t.year}</span><h3>{t.title}</h3><p>{t.text}</p></div>))}</div></div></section>

      <section class="story-band wrap"><div class="section-kicker"><span>04</span><span>STORIES FROM THE STREET</span></div><div class="story-grid">{stories.map((s) => (<article class="story-card"><span class="story-no">{s.no}</span><span class="story-tag">{s.tag}</span><h3>{s.title}</h3><p>{s.text}</p><em class="hand-note">{s.note}</em></article>))}</div></section>

      <section class="market-section wrap" id="market"><div class="photo-frame"><img src={image.market} alt="加雅街周日市集的水果与手作摊位" /><span class="photo-caption">SUNDAY MARKET / 07:00—12:00</span></div><div class="market-copy"><div class="section-kicker"><span>05</span><span>THE SUNDAY WALK</span></div><h2>先找香味，<br /><i>再决定往哪走。</i></h2><p>从街口开始，不必急着完成路线。先绕到有蒸汽的摊位，买一份热早餐；再看一眼手工藤编、植物和本地小吃。市集的乐趣不在“买了什么”，而在每个摊位都把城市的日常摊在阳光里。</p><div class="mini-facts"><div><strong>07:00</strong><span>建议抵达</span></div><div><strong>2–3h</strong><span>舒适停留</span></div><div><strong>RM 5+</strong><span>早餐预算</span></div></div></div></section>

      <section class="heritage-section wrap"><div class="heritage-copy"><div class="section-kicker"><span>06</span><span>LOOK UP</span></div><h2>不要只看摊位，<br /><i>抬头看看老店屋。</i></h2><p>五脚基把店铺、行人和天气连在一起。褪色的立面、窄窄的招牌、旧式百叶窗和深深的檐下阴影，是加雅街最安静的风景。</p><p class="hand-note">← 走慢一点，建筑会开始说话。</p></div><div class="heritage-photo"><img src={image.heritage} alt="加雅街老店屋的五脚基骑楼与旧式招牌" /></div></section>

      <section class="walk-band" id="walk"><div class="wrap"><div class="section-kicker light"><span>07</span><span>A WALK DOWN JALAN GAYA</span></div><h2>一条街，<br /><i>五种走法。</i></h2><div class="walk-route">{walk.map((w) => (<div class="walk-step"><b>{w.step}</b><span>{w.title}<small>{w.note}</small></span></div>))}</div></div></section>

      <section class="practical-band" id="practical"><div class="wrap"><div class="section-kicker light"><span>08</span><span>FIELD GUIDE</span></div><h2>把实用信息<br /><i>放在口袋里。</i></h2><div class="practical-grid"><article><span class="card-index">A / 到达</span><h3>详细交通</h3><p><b>机场：</b>Kota Kinabalu International Airport 距离市中心约 8 km。出租车或网约车通常最直接；机场巴士可到市中心，再沿 Jalan Pantai 步行。</p><p><b>公交：</b>以市中心站点为目标，抵达后从海滨一侧步行进入 Jalan Gaya。周日市集期间请预留绕行时间。</p><p><b>出租车：</b>直接报 “Gaya Street Sunday Market / Jalan Gaya”，并在下车前确认回程方式。</p></article><article><span class="card-index">B / 停留</span><h3>时间 & 费用</h3><p><b>最佳时段：</b>周日 07:00—10:00，较凉爽、摊位选择完整；傍晚适合回到附近夜市吃东西。</p><p><b>建议停留：</b>2—3 小时；如果加上早餐、老城散步和周边景点，可安排半天。</p><p><b>门票 / 费用：</b>街道和周日市集通常免费进入。消费以摊位和店家现场标价为准，建议准备小额现金。</p></article><article><span class="card-index">C / 停车</span><h3>停车信息</h3><p>市中心公共停车位和商场停车场是较稳妥选择。周日市集可能占用部分道路，建议提早到达，不要把车停在摊位通道或路口。</p><p class="tip">小提示：穿舒适鞋，带水，防晒；雨季随身带轻便雨具。</p></article></div></div></section>

      <section class="food-section wrap" id="nearby"><div class="section-kicker"><span>09</span><span>AROUND THE BLOCK</span></div><div class="food-grid"><div><h2>周边美食，<br /><i>从一碗热汤开始。</i></h2><p>加雅街周边的好味道不需要复杂攻略：早餐去找 laksa、kopi 和脆皮小吃；晚上沿着 Jalan Gaya 走，感受 Api-Api 夜市的烟火气。</p><a class="text-link" href="#map">把味道放进地图 →</a></div><img src={image.food} alt="亚庇街头早餐：kopi 与本地小吃" /></div><div class="food-list"><div><b>01</b><span>Guan’s Kopitiam Gaya Street</span><small>111, Jalan Gaya · 咖啡店与早餐</small></div><div><b>02</b><span>Api-Api Night Food Market</span><small>Jalan Gaya · 夜晚的街头小吃</small></div><div><b>03</b><span>本地 laksa & kuih</span><small>沿街寻找，不必拘泥于一家店</small></div></div></section>

