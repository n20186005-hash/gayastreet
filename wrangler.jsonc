{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gayastreet",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
